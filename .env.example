BUTTERFLY_CONFIG_TYPE=file
BUTTERFLY_CONFIG_FILE_PATH=./config/butter.yaml
BUTTERFLY_TRACING_PROVIDER=http
BUTTERFLY_TRACING_ENDPOINT=127.0.0.1:4318

# ADK v2.7+: maximum model calls per invocation (default 500; -1 disables).
# ADK_MAX_LLM_CALLS=500

# ADK v2.7 defaults to the new GenAI telemetry schema. For collectors that
# still need the old format, opt back in (supported until at least 2027-03-31).
# ADK_TELEMETRY_SCHEMA_VERSION_OPT_IN=otel_semconv_1_36
